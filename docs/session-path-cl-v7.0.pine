// --- Research follow-up v1: completed candles, isolated from the Mean boxes. ---
string researchMarket = "CL"
float REPS = 0.00000001
f_rnum(array<string> parts, int index) =>
    array.size(parts) > index ? str.tonumber(array.get(parts, index)) : na
f_rtext(array<string> parts, int index) =>
    array.size(parts) > index ? array.get(parts, index) : ""
f_rvalue(float value) =>
    na(value) ? "NA" : str.tostring(value, "0.########")
f_rsame(float left, float right) =>
    not na(left) and not na(right) and math.abs(left - right) <= 0.000001
f_rtriplet(array<string> parts, int index) =>
    float p = f_rnum(parts, index)
    float k = f_rnum(parts, index + 1)
    float n = f_rnum(parts, index + 2)
    not na(p) and not na(k) and not na(n) and ((p == -1 and k == 0 and n == 0) or (p >= 0 and p <= 100 and n >= 1 and n == math.floor(n) and k >= 0 and k <= n and k == math.floor(k)))
f_rpacket(array<string> parts, string kind) =>
    int codedFrom = int(f_rnum(parts, 3))
    int codedUntil = int(f_rnum(parts, 4))
    int through = int(f_rnum(parts, 17))
    int midnight = not na(codedFrom) ? timestamp(TZ, year(codedFrom, TZ), month(codedFrom, TZ), dayofmonth(codedFrom, TZ), 0, 0) : na
    float flags = f_rnum(parts, 19)
    array.size(parts) == 20 and f_rtext(parts, 0) == "SR1" and f_rtext(parts, 1) == researchMarket and f_rtext(parts, 2) == kind and not na(codedFrom) and not na(codedUntil) and codedFrom > 0 and codedUntil > codedFrom and codedFrom % 300000 == 0 and codedUntil % 300000 == 0 and f_rnum(parts, 5) > f_rnum(parts, 6) and not na(through) and through > 0 and through < midnight and f_rtriplet(parts, 8) and f_rtriplet(parts, 11) and f_rtriplet(parts, 14) and not na(flags) and flags >= 0 and flags <= 7 and flags == math.floor(flags)
f_rprob(array<string> parts, int index) =>
    float p = f_rnum(parts, index)
    p >= 0 ? str.tostring(p, "0.0") + "%" : "Unavailable"
f_rsupport(array<string> parts, int index) =>
    float n = f_rnum(parts, index + 2)
    n >= 1 ? str.tostring(f_rnum(parts, index + 1), "#") + "/" + str.tostring(n, "#") + " earlier dates" : "No eligible earlier dates"
f_rtip(array<string> parts, int index) =>
    float n = f_rnum(parts, index + 2)
    float k = f_rnum(parts, index + 1)
    string tipText = "Historical reference from the website; supporting raw outcomes " + f_rsupport(parts, index) + ". Displayed probability may be shrunk toward a broader earlier-date baseline and need not equal raw k/n. Data through " + str.format_time(int(f_rnum(parts, 17)), "yyyy-MM-dd", TZ) + "."
    if n > 0
        float r = k / n
        float den = 1 + 3.8416 / n
        float center = (r + 1.9208 / n) / den
        float half = 1.96 * math.sqrt(r * (1 - r) / n + 0.9604 / (n * n)) / den
        tipText += " Raw-frequency 95% Wilson interval " + str.tostring(100 * math.max(0, center - half), "0.0") + "%-" + str.tostring(100 * math.min(1, center + half), "0.0") + "%; this interval is for k/n, not the pooled model."
    tipText

// An independent running range continues after 08:30 so a NY breach snapshot
