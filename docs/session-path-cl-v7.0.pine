// Array state: start,end,U,D,complete,next,side,signalClose,type,close,H,L,
// overshootBand,already120,already130,returnedAt,future120At,future130At,printed,bboxInside.
// Every written call has its own persistent state. No unfinished candle qualifies.
f_researchBreach(int start, int finish, float upper, float lower, bool enabled) =>
    var array<float> s = array.new<float>(20, na)
    if enabled and not na(start) and (na(array.get(s, 0)) or array.get(s, 0) != start)
        array.fill(s, na)
        array.set(s, 0, start)
        array.set(s, 1, finish)
        array.set(s, 2, upper)
        array.set(s, 3, lower)
        array.set(s, 4, 1)
        array.set(s, 6, 0)
    if enabled and barstate.isconfirmed and withinForecastCursor and upper > lower and time >= start and time < finish
        // Dated chart opens are unknown before their actual start bar. Store the
        // bounds only once they exist; an earlier NA must not poison the export.
        array.set(s, 2, upper)
        array.set(s, 3, lower)
        bool initial = na(array.get(s, 5))
        bool completeWindow = array.get(s, 4) == 1 and (initial ? time == start : time == int(array.get(s, 5)))
        array.set(s, 4, completeWindow ? 1 : 0)
        array.set(s, 5, time_close)
        float width = upper - lower
        if array.get(s, 6) == 0
            bool up = high > upper + REPS
            bool down = low < lower - REPS
            if up or down
                int direction = up and down ? 2 : up ? 1 : -1
                bool outside = close > upper + REPS or close < lower - REPS
                float target120 = direction == 1 ? lower + 1.2 * width : upper - 1.2 * width
                float target130 = direction == 1 ? lower + 1.3 * width : upper - 1.3 * width
                array.set(s, 6, direction)
                array.set(s, 7, time_close)
                array.set(s, 8, direction == 2 ? 2 : outside ? 1 : 0)
                array.set(s, 9, close)
                array.set(s, 10, high)
                array.set(s, 11, low)
                array.set(s, 12, outside and direction != 2 ? math.floor(math.max(0, direction == 1 ? close - upper : lower - close) / width * 10 + REPS) * 10 : na)
                array.set(s, 13, direction == 2 ? na : (direction == 1 ? high >= target120 - REPS : low <= target120 + REPS) ? 1 : 0)
                array.set(s, 14, direction == 2 ? na : (direction == 1 ? high >= target130 - REPS : low <= target130 + REPS) ? 1 : 0)
                array.set(s, 18, rRunComplete and nightAvr > 0 ? 100 * (rRunHigh - rRunLow) / nightAvr : na)
                array.set(s, 19, priorNyHigh > priorNyLow ? (close >= priorNyLow - REPS and close <= priorNyHigh + REPS ? 1 : 0) : na)
        if array.get(s, 6) != 0 and time_close > int(array.get(s, 7))
            int direction = int(array.get(s, 6))
            float target120 = direction == 1 ? lower + 1.2 * width : upper - 1.2 * width
            float target130 = direction == 1 ? lower + 1.3 * width : upper - 1.3 * width
            if direction != 2
                if array.get(s, 8) == 1 and na(array.get(s, 15)) and time_close <= math.min(finish, int(array.get(s, 7)) + 1200000) and close >= lower - REPS and close <= upper + REPS
                    array.set(s, 15, time_close)
                if array.get(s, 13) == 0 and na(array.get(s, 16)) and (direction == 1 ? high >= target120 - REPS : low <= target120 + REPS)
                    array.set(s, 16, time_close)
                if array.get(s, 14) == 0 and na(array.get(s, 17)) and (direction == 1 ? high >= target130 - REPS : low <= target130 + REPS)
                    array.set(s, 17, time_close)
    s

array<float> rBreach0300 = f_researchBreach(rStart0300, rEnd0300, rPrice0300 + estimateUp, rPrice0300 - estimateDown, rDated0300)
array<float> rBreach0500 = f_researchBreach(rStart0500, rEnd0500, rPrice0500 + estimateUp0500, rPrice0500 - estimateDown0500, rDated0500)
array<float> rBreachNY = f_researchBreach(drawNYStart, drawNYEnd, drawNYPrice + estimateUpNY, drawNYPrice - estimateDownNY, rDatedNY)
f_rside(array<float> s) =>
    array.get(s, 6) == 1 ? "U" : array.get(s, 6) == -1 ? "D" : array.get(s, 6) == 2 ? "B" : ""
f_rtype(array<float> s) =>
    array.get(s, 8) == 1 ? "CLOSE_OUTSIDE" : array.get(s, 8) == 0 ? "WICK_ONLY" : "BOTH_UNKNOWN"
f_rsnapshot(array<float> s) =>
    var int cachedWindow = na
    var int cachedSignal = na
    var string cachedPacket = ""
    if not na(array.get(s, 0)) and (na(cachedWindow) or cachedWindow != int(array.get(s, 0)))
        cachedWindow := int(array.get(s, 0))
        cachedSignal := na
        cachedPacket := ""
    bool ready = array.get(s, 4) == 1 and array.get(s, 6) != 0 and not na(array.get(s, 7))
    if ready and (na(cachedSignal) or cachedSignal != int(array.get(s, 7)))
        cachedSignal := int(array.get(s, 7))
        cachedPacket := "SFB1|" + researchMarket + "|" + f_rvalue(array.get(s, 0)) + "|" + f_rvalue(array.get(s, 1)) + "|" + f_rvalue(array.get(s, 7)) + "|" + f_rvalue(array.get(s, 2)) + "|" + f_rvalue(array.get(s, 3)) + "|" + f_rside(s) + "|" + f_rtype(s) + "|" + f_rvalue(array.get(s, 9)) + "|" + f_rvalue(array.get(s, 10)) + "|" + f_rvalue(array.get(s, 11)) + "|" + f_rvalue(array.get(s, 18)) + "|" + f_rvalue(array.get(s, 19))
    ready ? cachedPacket : ""
f_researchEndpoint(int at, int deadline, float upper, float lower, bool enabled) =>
    var string packet = ""
    if enabled and barstate.isconfirmed and withinForecastCursor and time_close == at and rRunComplete and rRunNext == at and upper > lower
        string state = close > upper + REPS ? "ABOVE_U" : close < lower - REPS ? "BELOW_D" : "INSIDE"
        packet := "SEP1|" + researchMarket + "|" + str.tostring(at) + "|" + str.tostring(deadline) + "|" + f_rvalue(rRunHigh) + "|" + f_rvalue(rRunLow) + "|" + f_rvalue(close) + "|" + f_rvalue(upper) + "|" + f_rvalue(lower) + "|" + state
    packet
string rEP0500 = f_researchEndpoint(rEnd0300, timestamp(TZ, year(rEnd0300, TZ), month(rEnd0300, TZ), dayofmonth(rEnd0300, TZ), 8, 30), rPrice0300 + estimateUp, rPrice0300 - estimateDown, rDated0300)
string rEP0830 = f_researchEndpoint(rEnd0500, timestamp(TZ, year(rEnd0500, TZ), month(rEnd0500, TZ), dayofmonth(rEnd0500, TZ), 16, 0), rPrice0500 + estimateUp0500, rPrice0500 - estimateDown0500, rDated0500)

var array<string> rEP = str.split(str.trim(endpointResearchCode), "|")
var array<string> rFB = str.split(str.trim(breachResearchCode), "|")
var int rEPStart = int(f_rnum(rEP, 3))
var int rEPEnd = int(f_rnum(rEP, 4))
var int rFBStart = int(f_rnum(rFB, 3))
var int rFBEnd = int(f_rnum(rFB, 4))
bool rEPTimeValid = not na(rEPStart) and (hour(rEPStart, TZ) == 5 and minute(rEPStart, TZ) == 0 and rEPEnd - rEPStart == 12600000 or hour(rEPStart, TZ) == 8 and minute(rEPStart, TZ) == 30 and rEPEnd - rEPStart == 27000000)
bool rFBTimeValid = not na(rFBEnd) and (hour(rFBEnd, TZ) == 5 and minute(rFBEnd, TZ) == 0 and rFBStart > rFBEnd - 7200000 or hour(rFBEnd, TZ) == 8 and minute(rFBEnd, TZ) == 30 and rFBStart > rFBEnd - 12600000 or hour(rFBEnd, TZ) == 16 and minute(rFBEnd, TZ) == 0 and rFBStart > rFBEnd - 27000000) and rFBStart <= rFBEnd
var bool rEPValid = f_rpacket(rEP, "EP") and rEPTimeValid and f_rtext(rEP, 7) == "B" and f_rnum(rEP, 19) == 0 and (f_rtext(rEP, 18) == "ABOVE_U" or f_rtext(rEP, 18) == "INSIDE" or f_rtext(rEP, 18) == "BELOW_D")
// Strength experiments stay on the website: SR1 does not encode the actual
// overshoot band, so a strength-filtered estimate cannot be chart-verified here.
var bool rFBValid = f_rpacket(rFB, "FB") and rFBTimeValid and f_rnum(rFB, 19) < 4 and (f_rtext(rFB, 7) == "U" or f_rtext(rFB, 7) == "D") and (f_rtext(rFB, 18) == "CLOSE_OUTSIDE" or f_rtext(rFB, 18) == "WICK_ONLY")
string rEPSnapshot = not na(rEPStart) and hour(rEPStart, TZ) == 5 ? rEP0500 : rEP0830
var string rEPCached = ""
var array<string> rEPObserved = array.new<string>()
if rEPSnapshot != rEPCached
    rEPObserved := str.split(rEPSnapshot, "|")
    rEPCached := rEPSnapshot
bool researchEPVerified = rEPValid and array.size(rEPObserved) == 10 and int(f_rnum(rEPObserved, 2)) == rEPStart and int(f_rnum(rEPObserved, 3)) == rEPEnd and f_rsame(f_rnum(rEPObserved, 4), f_rnum(rEP, 5)) and f_rsame(f_rnum(rEPObserved, 5), f_rnum(rEP, 6)) and f_rtext(rEPObserved, 9) == f_rtext(rEP, 18)
array<float> rFBObserved = not na(rFBEnd) and hour(rFBEnd, TZ) == 5 ? rBreach0300 : not na(rFBEnd) and hour(rFBEnd, TZ) == 8 ? rBreach0500 : rBreachNY
var int rFBFlags = int(f_rnum(rFB, 19))
bool researchFBVerified = rFBValid and array.get(rFBObserved, 4) == 1 and int(array.get(rFBObserved, 7)) == rFBStart and int(array.get(rFBObserved, 1)) == rFBEnd and f_rsame(array.get(rFBObserved, 2), f_rnum(rFB, 5)) and f_rsame(array.get(rFBObserved, 3), f_rnum(rFB, 6)) and f_rside(rFBObserved) == f_rtext(rFB, 7) and f_rtype(rFBObserved) == f_rtext(rFB, 18) and (rFBFlags % 2 == 1 ? 1 : 0) == array.get(rFBObserved, 13) and (rFBFlags % 4 >= 2 ? 1 : 0) == array.get(rFBObserved, 14) and (na(chartForecastAsOf) or chartForecastAsOf < rFBEnd or int(array.get(rFBObserved, 5)) == rFBEnd)
int researchFBWindowStart = int(array.get(rFBObserved, 0))
var bool rEPHigher = false
var bool rEPLower = false
if researchEPVerified and barstate.isconfirmed and withinForecastCursor and time >= rEPStart and time < rEPEnd
    rEPHigher := rEPHigher or high > f_rnum(rEP, 5) + REPS
    rEPLower := rEPLower or low < f_rnum(rEP, 6) - REPS

// Logs/alerts export confirmed observations; they never manufacture probabilities.
f_emitResearch(string packet, string previous) =>
    if str.length(packet) > 0 and packet != previous
        if emitResearchSnapshots
            log.info("{0}", packet)
        if researchSnapshotAlerts and barstate.isrealtime and barstate.isconfirmed
            alert(packet, alert.freq_all)
    packet
var string rLast0300 = ""
var string rLast0500 = ""
var string rLastNY = ""
var string rLastEP0500 = ""
var string rLastEP0830 = ""
rLast0300 := f_emitResearch(f_rsnapshot(rBreach0300), rLast0300)
rLast0500 := f_emitResearch(f_rsnapshot(rBreach0500), rLast0500)
rLastNY := f_emitResearch(f_rsnapshot(rBreachNY), rLastNY)
rLastEP0500 := f_emitResearch(rEP0500, rLastEP0500)
rLastEP0830 := f_emitResearch(rEP0830, rLastEP0830)
// --- End isolated research calculations. ---

var array<line> forecastStatLines = array.new<line>()
var array<label> rangeExtensionLabels = array.new<label>()
// Pine drawing objects reproduce Fibonacci extension levels; native mouse-drawn Fib objects are separate.
f_meanOuterLines(int start, int finish, float price, float meanUp, float meanDown) =>
    float fullWidth = meanUp + meanDown
    if fullWidth > 0 and meanOuterBands != "Off"
        for levelIndex = 0 to 1
            float fraction = levelIndex == 0 ? 0.10 : 0.15
            bool enabled = meanOuterBands == "Both" or (levelIndex == 0 and meanOuterBands == "10%") or (levelIndex == 1 and meanOuterBands == "15%")
            if enabled
                if showMeanUpper
                    float upperLevel = price + meanUp + fraction * fullWidth
                    array.push(forecastStatLines, line.new(start, upperLevel, finish, upperLevel, xloc = xloc.bar_time, color = color.rgb(173, 95, 230), style = line.style_dotted, width = 1))
                if showMeanLower
                    float lowerLevel = price - meanDown - fraction * fullWidth
                    array.push(forecastStatLines, line.new(start, lowerLevel, finish, lowerLevel, xloc = xloc.bar_time, color = color.rgb(173, 95, 230), style = line.style_dotted, width = 1))

