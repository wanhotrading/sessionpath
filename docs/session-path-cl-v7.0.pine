    if na(rRunStart) or rRunStart != startForBar
        rRunStart := startForBar
        rRunNext := time
        rRunHigh := na
        rRunLow := na
        rRunComplete := time == startForBar
    rRunComplete := rRunComplete and time == rRunNext
    rRunHigh := na(rRunHigh) ? high : math.max(rRunHigh, high)
    rRunLow := na(rRunLow) ? low : math.min(rRunLow, low)
    rRunNext := time_close

