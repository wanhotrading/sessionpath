// Each written call owns its own state. Stop at the selected visible candle and window end.
f_firstBoxBreach(int start, int finish, float upper, float lower) =>
    var int activeStart = na
    var int firstSide = 0
    var int breachTime = na
    if not na(start) and (na(activeStart) or start != activeStart)
        activeStart := start
        firstSide := 0
        breachTime := na
    if withinForecastCursor and not na(upper) and not na(lower) and time >= start and time < finish and firstSide == 0
        bool upBreach = high > upper
        bool downBreach = low < lower
        if upBreach or downBreach
            firstSide := upBreach and downBreach ? 2 : upBreach ? 1 : -1
            breachTime := time
    [firstSide, breachTime]

[firstBoxSide, firstBoxBreachTime] = f_firstBoxBreach(lockedWindows ? firstWindowStart : estimateStart, lockedWindows ? firstWindowEnd : estimateEnd, lockedWindows ? firstWindowPrice + firstWindowUp : estimatePrice + estimateUp, lockedWindows ? firstWindowPrice - firstWindowDown : estimatePrice - estimateDown)
