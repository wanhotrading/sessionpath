f_nyExtensionLabel(int start, int finish, float multiple, int direction, float target) =>
    string side = direction == 1 ? "U" : "D"
    string suffix = ""
    string explanation = ""
    int referenceIndex = nyQ7Reference == "Own Exact" ? 0 : nyQ7Reference == "Own Wide" ? 1 : nyQ7Reference == "Prior Exact" ? 2 : nyQ7Reference == "Prior Wide" ? 3 : -1
    int level = math.abs(multiple - 1.20) < 0.000001 ? 0 : math.abs(multiple - 1.30) < 0.000001 ? 1 : math.abs(multiple - 1.40) < 0.000001 ? 2 : math.abs(multiple - 1.50) < 0.000001 ? 3 : -1
    int fit = nyProbabilityFit == "50+ earlier matches" ? 0 : 1
    int minimumFit = fit == 0 ? 50 : 1
    int cohort = nyProbabilityCohort == "All eligible NY forecasts" ? 0 : nyProbabilityCohort == "04:30 double break - second U" ? 1 : nyProbabilityCohort == "04:30 double break - second D" ? 2 : nyProbabilityCohort == "03:00-05:00 both orange boxes - second U" ? 3 : nyProbabilityCohort == "03:00-05:00 both orange boxes - second D" ? 4 : nyProbabilityCohort == "05:00-08:30 both orange boxes - second U" ? 5 : 6
    int basis = nyProbabilityBasis == "Whole-window directional" ? 0 : nyProbabilityBasis == "First breakout side" ? 1 : 2
    int observedAsOf = barstate.isconfirmed ? time_close : time
    bool reached = direction == 1 ? nyProbabilityHigh >= target - 0.000000001 : nyProbabilityLow <= target + 0.000000001
    bool isFirstDirection = nyProbabilitySide == direction
    if showRangeHitRates
        if referenceIndex < 0
            suffix := " | " + side + " Hist n/a"
            explanation := "Select the NY research reference matching the website's Own/Prior and Exact/Wide method. The code does not identify that method."
        else if level < 0
            suffix := " | " + side + " Hist n/a"
            explanation := "New earlier-only NY research covers 1.20, 1.30, 1.40 and 1.50 only. This level has no matching new NY probability. No legacy NY percentage is substituted."
        else if estimateNNY < minimumFit
            suffix := " | " + side + " fit n/a"
            explanation := "This imported NY forecast has fewer earlier matches than the selected historical fit minimum. Use a matching fit threshold; sensitivity fits may be sparse."
        else if basis > 0 and not nyProbabilityComplete
            suffix := " | " + side + " state n/a"
            explanation := "The chart lacks a continuous 08:30-to-observation candle sequence. First-breakout order and pending-target state cannot be verified from the loaded chart."
        else if basis > 0 and nyProbabilitySide == 2
            suffix := " | " + side + " order n/a"
            explanation := "Both initial Mean-box boundaries broke in the same five-minute candle. Their order is unknown; first-side and pending samples exclude these cases."
        else if basis > 0 and nyProbabilitySide != 0 and not isFirstDirection
            suffix := " | " + side + " not first"
            explanation := "The opposite side already broke first. A first-" + side + " probability does not apply to this observed sequence. Whole-window directional frequencies remain available under NY probability basis."
        else if basis == 2 and reached
            suffix := " | " + side + " reached"
            explanation := "This target was already touched at or before the selected chart observation, including any trigger-candle or next-open hit. A pending-target reference does not apply after a hit."
        else if basis == 2 and observedAsOf >= finish
            suffix := " | " + side + " ended"
            explanation := "The NY window has ended. There are no remaining candles for a pending target."
        else if basis == 2 and not na(nyProbabilityBreachTime) and nyProbabilityBreachTime + 300000 >= finish
            suffix := " | " + side + " no time"
            explanation := "The first breakout candle confirms at the window endpoint, leaving no eligible later candle. Such cases are excluded from pending-target denominators."
        else if basis == 2 and not nyProbabilityConfirmed
            suffix := " | " + side + (nyProbabilitySide == 0 ? " await break" : " await close")
            explanation := "The default pending reference is shown only for the direction of a confirmed first breakout. Wait for a strict Mean-box boundary breach and completion of that five-minute candle. The target must still be untouched and at least one candle must remain. No pre-confirmation percentage is shown."
        else
            int index = (((((referenceIndex * 2 + fit) * 7 + cohort) * 4 + level) * 3 + basis) * 2 + (direction == 1 ? 0 : 1)) * 2
            int k = array.get(nyExtensionCounts, index)
            int n = array.get(nyExtensionCounts, index + 1)
            if n == 0
                suffix := " | " + side + " Hist n/a"
                explanation := "No eligible historical cases for this selected NY method, minimum fit, earlier tail event, direction and probability basis. Unavailable is not a 0% forecast."
            else
                float probability = float(k) / n
                float z2 = 3.841458820694
                float center = (probability + z2 / (2 * n)) / (1 + z2 / n)
                float half = 1.95996398454 * math.sqrt(probability * (1 - probability) / n + z2 / (4 * n * n)) / (1 + z2 / n)
                bool beforeConfirmation = nyProbabilitySide == 0 or not nyProbabilityConfirmed
                string condition = basis == 0 ? " Hist " : basis == 1 ? (beforeConfirmation ? " if " + side + " first " : " first Hist ") : " UNREACHED @conf "
                suffix := " | " + (basis == 1 and beforeConfirmation ? "" : side) + condition + "R " + str.tostring(100 * probability, "0.0") + "% / M " + str.tostring(100 * (1 - probability), "0.0") + "%"
                explanation := "NY 08:30-16:00 " + nyQ7Reference + " Mean / " + side + " / " + nyProbabilityBasis + ": " + str.tostring(k) + "/" + str.tostring(n) + ". 95% Wilson interval " + str.tostring(100 * math.max(0, center - half), "0.0") + "%-" + str.tostring(100 * math.min(1, center + half), "0.0") + "%. Earlier-only 2022-2026 reconstructed forecasts. Fit minimum: " + str.tostring(minimumFit) + ". Preceding condition: " + nyProbabilityCohort + ". Upper and lower counts remain separate. "
                explanation += "R = historical reached percentage; M = historical missed/unreached percentage in the same denominator. "
                explanation += basis == 0 ? "Denominator: every eligible NY forecast in this cohort, including no-break days. Numerator: a wick touched this directional target anywhere in [08:30,16:00). The two sides may overlap." : basis == 1 ? "Denominator: resolved first strict wick breakouts on this side. Target touches anywhere through 16:00, including the trigger candle. No-break and same-candle unknown-order cases excluded." : "UNREACHED is the actual chart target state at the selected observation. Denominator: resolved first breaks on this side with target untouched through the trigger candle AND the next opening price, and at least one later candle. Numerator: a later wick touched the target before 16:00. This reference is measured at first confirmation; it is NOT recalculated for elapsed time or current distance as later candles pass. Only the confirmed first-breakout direction receives this pending percentage."
                explanation += n < 30 ? " Small sample: exploratory only." : ""
                explanation += " The selected tail event must actually have completed before 08:30. Rates are historical reference frequencies, not today's refitted probability or trade win rates."
    [suffix, explanation]

f_q7Label(int start, int finish, float multiple, int direction, bool ambiguous, bool beforeBreach) =>
    int duration = finish - start
    int variant = hour(start, TZ) == 3 and minute(start, TZ) == 0 and duration == 7200000 ? 0 : hour(start, TZ) == 5 and minute(start, TZ) == 0 and duration == 12600000 ? 1 : -1
    int levelIndex = math.abs(multiple - 1.05) < 0.000001 ? 0 : math.abs(multiple - 1.10) < 0.000001 ? 1 : math.abs(multiple - 1.15) < 0.000001 ? 2 : math.abs(multiple - 1.20) < 0.000001 ? 3 : math.abs(multiple - 1.30) < 0.000001 ? 4 : math.abs(multiple - 1.50) < 0.000001 ? 5 : math.abs(multiple - 1.75) < 0.000001 ? 6 : math.abs(multiple - 2.00) < 0.000001 ? 7 : -1
    string suffix = ""
    string explanation = ""
    if showRangeHitRates
        if ambiguous
            suffix := " | Hist n/a"
            explanation := "First UP and DOWN breach share one candle; order is unknown. These cases were excluded from the first-side research denominator."
        else if variant < 0 or levelIndex < 0
            suffix := " | Hist n/a"
            explanation := "No matching legacy early-window reference exists for this duration or level. The added 1.40 level is available in the new NY research only."
        else
            int row = variant * 2 + (direction == 1 ? 0 : 1)
            int n = q7History == "Earlier-date boxes" ? array.get(q7EarlierSamples, row) : array.get(q7ReconstructionSamples, row)
            int k = q7History == "Earlier-date boxes" ? array.get(q7EarlierHits, row * 8 + levelIndex) : array.get(q7ReconstructionHits, row * 8 + levelIndex)
            float probability = float(k) / n
            float z2 = 3.841458820694
            float center = (probability + z2 / (2 * n)) / (1 + z2 / n)
            float half = 1.95996398454 * math.sqrt(probability * (1 - probability) / n + z2 / (4 * n * n)) / (1 + z2 / n)
            suffix := " | NQ " + str.tostring(100 * probability, "0.0") + "%" + (beforeBreach ? " if first" : "")
            string reference = variant == 0 ? "03:00-05:00 Mean" : "05:00-08:30 Mean"
            explanation := reference + (direction == 1 ? " / first UP breach" : " / first DOWN breach") + ": " + str.tostring(k) + "/" + str.tostring(n) + " eligible breached days reached this level by the window endpoint. 95% Wilson interval " + str.tostring(100 * (center - half), "0.0") + "%-" + str.tostring(100 * (center + half), "0.0") + "%. NQ 2022-2026 " + (q7History == "Earlier-date boxes" ? "earlier-date boxes" : "all-history reconstructed boxes") + "; reference frequency, not today's fitted probability. Includes hits during the breach candle. No-break and same-bar two-sided first breaches excluded. Not a trade win rate or a remaining-chance estimate."
    [suffix, explanation]

f_extensionLabel(int start, int finish, float multiple, int direction, float target, bool ambiguous, bool beforeBreach) =>
    bool nyWindow = hour(start, TZ) == 8 and minute(start, TZ) == 30 and finish - start == 27000000
    if nyWindow
        f_nyExtensionLabel(start, finish, multiple, direction, target)
    else
        f_q7Label(start, finish, multiple, direction, ambiguous, beforeBreach)

f_rangeExtensions(int start, int finish, float price, float meanUp, float meanDown, int firstSide, int breachTime) =>
    float upper = price + meanUp
    float lower = price - meanDown
    float fullWidth = upper - lower
    bool both = rangeExtensionMode == "Both sides"
    bool ready = both or (rangeExtensionMode == "First breached side" and firstSide != 0 and not na(breachTime))
    int lineStart = both ? start : math.max(start, breachTime)
    if rangeExtensionMode != "Off" and ready and fullWidth > 0 and lineStart < finish
        array<float> multiples = array.from(1.05, 1.10, 1.15, 1.20, 1.30, 1.40, 1.50, 1.75, 2.00)
        array<bool> selected = array.from(range105, range110, range115, range120, range130, range140, range150, range175, range200)
        for i = 0 to array.size(multiples) - 1
            if array.get(selected, i)
                float multiple = array.get(multiples, i)
                string caption = str.tostring(multiple, "0.00") + "x" + (not both and firstSide == 2 ? " ?" : "")
                if both or firstSide == 1 or firstSide == 2
                    float levelUp = lower + multiple * fullWidth
                    [upSuffix, upExplanation] = f_extensionLabel(followForecast ? na : start, finish, multiple, 1, levelUp, firstSide == 2, both)
                    array.push(forecastStatLines, line.new(lineStart, levelUp, finish, levelUp, xloc = xloc.bar_time, color = color.orange, style = line.style_dotted, width = 1))
                    if rangeLevelLabels
                        array.push(rangeExtensionLabels, label.new(finish, levelUp, caption + upSuffix, xloc = xloc.bar_time, style = label.style_label_right, color = color.new(color.orange, 100), textcolor = color.rgb(156, 75, 0), size = size.small, tooltip = "Upward full-box multiple: lower + multiple x (upper - lower).\n" + upExplanation))
                if both or firstSide == -1 or firstSide == 2
                    float levelDown = upper - multiple * fullWidth
                    [downSuffix, downExplanation] = f_extensionLabel(followForecast ? na : start, finish, multiple, -1, levelDown, firstSide == 2, both)
                    array.push(forecastStatLines, line.new(lineStart, levelDown, finish, levelDown, xloc = xloc.bar_time, color = color.orange, style = line.style_dotted, width = 1))
                    if rangeLevelLabels
                        array.push(rangeExtensionLabels, label.new(finish, levelDown, caption + downSuffix, xloc = xloc.bar_time, style = label.style_label_right, color = color.new(color.orange, 100), textcolor = color.rgb(156, 75, 0), size = size.small, tooltip = "Downward full-box multiple: upper - multiple x (upper - lower).\n" + downExplanation))

f_statLines(int start, int finish, float price, float meanUp, float meanDown, float medianUp, float medianDown, int firstSide, int breachTime) =>
    f_rangeExtensions(start, finish, price, meanUp, meanDown, firstSide, breachTime)
    f_meanOuterLines(start, finish, price, meanUp, meanDown)
    array.push(forecastStatLines, line.new(start, price + meanUp, finish, price + meanUp, xloc = xloc.bar_time, color = color.orange, style = line.style_dotted, width = 1))
    array.push(forecastStatLines, line.new(start, price - meanDown, finish, price - meanDown, xloc = xloc.bar_time, color = color.orange, style = line.style_dotted, width = 1))
    if not na(medianUp) and not na(medianDown)
        array.push(forecastStatLines, line.new(start, price + medianUp, finish, price + medianUp, xloc = xloc.bar_time, color = color.white, style = line.style_dotted, width = 1))
        array.push(forecastStatLines, line.new(start, price - medianDown, finish, price - medianDown, xloc = xloc.bar_time, color = color.white, style = line.style_dotted, width = 1))

f_lockedWindow(int start, int finish, float price, float up, float down, float meanUp, float meanDown, float medianUp, float medianDown, string heading, string sourceNote, bool ended, int firstSide, int breachTime) =>
    box upper = box.new(left = start, top = price + up, right = finish, bottom = price, xloc = xloc.bar_time, border_color = color.teal, bgcolor = color.new(color.teal, 87))
    box lower = box.new(left = start, top = price, right = finish, bottom = price - down, xloc = xloc.bar_time, border_color = color.maroon, bgcolor = color.new(color.red, 90))
    f_statLines(start, finish, price, meanUp, meanDown, medianUp, medianDown, firstSide, breachTime)
    label tag = label.new(x = finish, y = price + up, text = heading + (ended ? " | ENDED" : " | LOCKED") + "\nOpen " + f_price(price) + " | Mean U +" + f_price(up) + " / D -" + f_price(down) + "\n" + sourceNote, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.navy, 10), textcolor = color.white, size = size.small)
    [upper, lower, tag]

var box firstUpperBox = na
var box firstLowerBox = na
var label firstWindowLabel = na
var box secondUpperBox = na
var box secondLowerBox = na
var label secondWindowLabel = na
var int selectedWindowTime = na
var box nyUpperBox = na
var box nyLowerBox = na
var label nyWindowLabel = na
if forecastRenderBar
    while array.size(forecastStatLines) > 0
        line.delete(array.pop(forecastStatLines))
    while array.size(rangeExtensionLabels) > 0
        label.delete(array.pop(rangeExtensionLabels))
    selectedWindowTime := barstate.isconfirmed ? time_close : time
    box.delete(firstUpperBox)
    box.delete(firstLowerBox)
    label.delete(firstWindowLabel)
    box.delete(secondUpperBox)
    box.delete(secondLowerBox)
    label.delete(secondWindowLabel)
    box.delete(nyUpperBox)
    box.delete(nyLowerBox)
    label.delete(nyWindowLabel)
    if showForecast and lockedWindows
        if not na(firstWindowPrice)
            [firstUpper, firstLower, firstTag] = f_lockedWindow(firstWindowStart, firstWindowEnd, firstWindowPrice, firstWindowUp, firstWindowDown, firstWindowUp, firstWindowDown, estimateMedianUp, estimateMedianDown, "03:00-05:00 NY", codedLocked0300 ? "Dated code | exact chart open | " + str.format_time(estimateStart, "yyyy-MM-dd", TZ) : "Mean U/D box | white median / orange mean | template", selectedWindowTime >= firstWindowEnd, firstBoxSide, firstBoxBreachTime)
            firstUpperBox := firstUpper
            firstLowerBox := firstLower
            firstWindowLabel := firstTag
        if not na(secondWindowPrice)
            [secondUpper, secondLower, secondTag] = f_lockedWindow(secondWindowStart, secondWindowEnd, secondWindowPrice, secondWindowUp, secondWindowDown, secondWindowUp, secondWindowDown, estimateMedianUp0500, estimateMedianDown0500, "05:00-08:30 NY", codedLocked0500 ? "Dated code | exact chart open | " + str.format_time(estimateStart0500, "yyyy-MM-dd", TZ) : "Mean U/D box | white median / orange mean | template", selectedWindowTime >= secondWindowEnd, secondBoxSide, secondBoxBreachTime)
            secondUpperBox := secondUpper
            secondLowerBox := secondLower
            secondWindowLabel := secondTag

// NY owns its 08:30 anchor and endpoint, independently of the two overnight fields.
bool nyReady = nyEstimateValid and not na(drawNYPrice) and not na(selectedWindowTime) and selectedWindowTime >= drawNYStart
if forecastRenderBar and showForecast and nyReady
    string nyHeading = "NY 08:30-" + str.format_time(drawNYEnd, "HH:mm", TZ)
    string nySource = "Mean U/D | white median / orange mean | source " + str.format_time(estimateStartNY, "yyyy-MM-dd", TZ)
    [nyUpper, nyLower, nyTag] = f_lockedWindow(drawNYStart, drawNYEnd, drawNYPrice, estimateUpNY, estimateDownNY, estimateUpNY, estimateDownNY, estimateMedianUpNY, estimateMedianDownNY, nyHeading, nySource, selectedWindowTime >= drawNYEnd, nyBoxSide, nyBoxBreachTime)
    nyUpperBox := nyUpper
    nyLowerBox := nyLower
    nyWindowLabel := nyTag

// Table shows the selected window, even if the live chart has later bars loaded.
bool selectedSecondWindow = not na(selectedWindowTime) and selectedWindowTime >= secondWindowStart
float selectedLockedPrice = selectedSecondWindow ? secondWindowPrice : firstWindowPrice
float selectedLockedUp = selectedSecondWindow ? secondWindowUp : firstWindowUp
float selectedLockedDown = selectedSecondWindow ? secondWindowDown : firstWindowDown
bool selectedLockedReady = not na(selectedLockedPrice)
string lockedStatus = na(selectedWindowTime) or selectedWindowTime < firstWindowStart ? "Waiting 03:00" : selectedSecondWindow ? (not secondEstimateValid ? "Need 05:00 code" : not selectedLockedReady ? "Waiting 05:00 open" : selectedWindowTime >= secondWindowEnd ? "Ended 08:30" : "Locked 05:00") : not firstEstimateValid ? "Need 03:00 code" : not selectedLockedReady ? "Missing 03:00 bar" : selectedWindowTime >= firstWindowEnd ? "Ended 05:00" : "Locked 03:00"

var box estimateUpperBox = na
var box estimateLowerBox = na
var label estimateLabel = na
if forecastRenderBar
    box.delete(estimateUpperBox)
    box.delete(estimateLowerBox)
    label.delete(estimateLabel)
    if showForecast and forecastReady and not lockedWindows and not mainIsNY
        estimateUpperBox := box.new(left = drawEstimateStart, top = drawEstimatePrice + estimateUp, right = drawEstimateEnd, bottom = drawEstimatePrice, xloc = xloc.bar_time, border_color = color.teal, bgcolor = color.new(color.teal, 87))
        estimateLowerBox := box.new(left = drawEstimateStart, top = drawEstimatePrice, right = drawEstimateEnd, bottom = drawEstimatePrice - estimateDown, xloc = xloc.bar_time, border_color = color.maroon, bgcolor = color.new(color.red, 90))
        f_statLines(drawEstimateStart, drawEstimateEnd, drawEstimatePrice, estimateUp, estimateDown, estimateMedianUp, estimateMedianDown, followForecast ? 0 : firstBoxSide, followForecast ? na : firstBoxBreachTime)
        string estimateDescription = followForecast ? "FOLLOWING CANDLE - imported distances\nU +" + f_price(estimateUp) + " / D -" + f_price(estimateDown) + " pt\nRepositioned template; NOT recalculated" : "Matched average U +" + f_price(estimateUp) + " / D -" + f_price(estimateDown) + " pt\nHistorical containment " + f_percent(containment) + " | n=" + str.tostring(estimateN, "#") + "\nFixed website snapshot"
        estimateLabel := label.new(x = drawEstimateEnd, y = drawEstimatePrice + estimateUp, text = "Mean U/D box | white median / orange mean\n" + estimateDescription + "\n" + str.format_time(drawEstimateStart, "yyyy-MM-dd HH:mm", TZ) + " to " + str.format_time(drawEstimateEnd, "yyyy-MM-dd HH:mm", TZ) + " NY", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.navy, 10), textcolor = color.white, size = size.small)

// Dated matched additional-AVR expansion. Anchors and distances come only
// from the imported cutoff snapshot; chart extremes never move these boxes.
var array<box> matchedExpansionBoxes = array.new<box>()
f_matchedExpansion(int start, int finish, float cutoffHigh, float cutoffLow, float extraUp, float extraDown) =>
    int drawn = 0
    if extraUp > 0
        array.push(matchedExpansionBoxes, box.new(left = start, top = cutoffHigh + extraUp, right = finish, bottom = cutoffHigh, xloc = xloc.bar_time, border_color = color.orange, border_width = 1, bgcolor = color.new(color.orange, 84)))
        drawn += 1
    if extraDown > 0
        array.push(matchedExpansionBoxes, box.new(left = start, top = cutoffLow, right = finish, bottom = cutoffLow - extraDown, xloc = xloc.bar_time, border_color = color.orange, border_width = 1, bgcolor = color.new(color.orange, 84)))
        drawn += 1
    drawn

if forecastRenderBar
    while array.size(matchedExpansionBoxes) > 0
        box.delete(array.pop(matchedExpansionBoxes))
    if showForecast and showMatchedExpansion and not na(selectedWindowTime)
        if estimateValid and estimateExpansionValid and not mainIsNY and selectedWindowTime >= estimateStart
            f_matchedExpansion(estimateStart, estimateEnd, estimateRangeHigh, estimateRangeLow, estimateExtensionUp, estimateExtensionDown)
        if secondEstimateValid and estimateExpansionValid0500 and selectedWindowTime >= estimateStart0500
            f_matchedExpansion(estimateStart0500, estimateEnd0500, estimateRangeHigh0500, estimateRangeLow0500, estimateExtensionUp0500, estimateExtensionDown0500)
        if nyEstimateValid and estimateExpansionValidNY and selectedWindowTime >= estimateStartNY
            f_matchedExpansion(estimateStartNY, estimateEndNY, estimateRangeHighNY, estimateRangeLowNY, estimateExtensionUpNY, estimateExtensionDownNY)

// Compact table; full definitions and snapshot dates are available on hover.
string nyStatus = str.length(str.trim(nyCodeSource)) == 0 ? "Need NY code" : not nyEstimateValid ? "Invalid NY code" : not nyReady ? "Waiting 08:30 open" : selectedWindowTime >= drawNYEnd ? "Ended " + str.format_time(drawNYEnd, "HH:mm", TZ) : "Locked 08:30"
var table panel = table.new(position.top_right, 2, 11, bgcolor = color.new(color.black, 12), border_width = 1)
if barstate.islast
    color fg = color.white
    string fontSize = panelSize == "Tiny" ? size.tiny : panelSize == "Normal" ? size.normal : size.small
    string clock = not na(asof) ? str.format_time(asof, "HH:mm", TZ) + " NY" : "Waiting"
    string scenario = not complete ? "Missing bars" : not frozen ? "Forming" : not active ? "Ended" : side == 0 ? "Middle: off" : anchorFailed ? "Invalid anchor" : na(nightAvr) ? "Need AVR" : targetReached ? "Reached" : side == 1 ? "Low + AVR" : "High - AVR"
    string forecastState = nyReady ? nyStatus : lockedWindows ? lockedStatus : not estimateValid ? str.length(forecastCode) > 0 ? "Invalid code" : "No code" : not forecastReady ? "Not available yet" : followForecast ? "Template" : chartForecastAsOf >= estimateEnd ? "Expired" : "Snapshot"
    string snapshotTip = codedLocked0300 or codedLocked0500 or codedLockedNY ? "New dated code: each mean window uses its own encoded start/end and the exact chart opening price at that timestamp. Scrolling to a later date never moves these boxes or their expansion anchors. Legacy codes still use visible-day templates." : lockedWindows ? "Two NY windows use exact 03:00 and 05:00 opens. Prices and imported U/D distances remain frozen. First ends 05:00; second ends 08:30. Earlier boxes remain for review on the selected date. No historical matches are recalculated automatically. The optional 05:00 code supplies separate distances; blank disables the second window." : estimateValid ? "Source: " + str.format_time(estimateStart, "yyyy-MM-dd HH:mm", TZ) + " to " + str.format_time(estimateEnd, "yyyy-MM-dd HH:mm", TZ) + " NY. " + (followForecast ? "Only position changes. U/D points and duration remain from this source; matches are NOT recalculated for the chart candle. This is not a historical backtest prediction." : "Fixed website snapshot; recalculate when conditions change.") : "Calculate matched average U/D on the website, then paste its forecast code in Settings."
    table.cell(panel, 0, 0, "SESSION PATH", text_color = color.aqua, text_size = fontSize)
    table.cell(panel, 1, 0, clock, text_color = fg, text_size = fontSize, tooltip = "Last completed 5-minute bar. Updates only during 19:30-08:30 NY. " + (not na(asof) ? str.format_time(asof, "yyyy-MM-dd", TZ) : ""))
    table.cell(panel, 0, 1, "Price / 19:30", text_color = fg, text_size = fontSize)
    table.cell(panel, 1, 1, f_price(lastPrice) + " / " + f_price(open1930), text_color = fg, text_size = fontSize, tooltip = "Last completed 5-minute close / fixed 19:30 opening price. These values stop updating at 08:30.")
    table.cell(panel, 0, 2, "Running H / L", text_color = fg, text_size = fontSize)
    table.cell(panel, 1, 2, f_price(runningHigh) + " / " + f_price(runningLow), text_color = fg, text_size = fontSize)
    table.cell(panel, 0, 3, "04:30 H / L", text_color = fg, text_size = fontSize)
    table.cell(panel, 1, 3, f_price(fixedHigh) + " / " + f_price(fixedLow), text_color = fg, text_size = fontSize, tooltip = "Frozen 19:30-04:30 range. Later bars never move these boundaries.")
    table.cell(panel, 0, 4, "Current U / D", text_color = fg, text_size = fontSize)
    table.cell(panel, 1, 4, f_price(observedUp) + " / " + f_price(observedDown), text_color = fg, text_size = fontSize, tooltip = "Points from the 19:30 open: U = running high - open; D = open - running low. Observed excursions, not forecasts.")
    table.cell(panel, 0, 5, "Range / AVR %", text_color = fg, text_size = fontSize)
    table.cell(panel, 1, 5, f_price(printed) + " / " + f_percent(nightAvr > 0 ? 100 * printed / nightAvr : na), text_color = fg, text_size = fontSize)
    table.cell(panel, 0, 6, "AVR / scenario", text_color = color.orange, text_size = fontSize)
    table.cell(panel, 1, 6, f_price(nightAvr) + " | " + scenario, text_color = color.orange, text_size = fontSize, tooltip = avrState + ". AVR is frozen at 19:30; automatic = mean of ten complete NY ranges. The orange box is a scenario, not a probability target.")
    table.cell(panel, 0, 7, lockedWindows ? "Mean U / D" : followForecast ? "Template U / D" : "Avg future U / D", text_color = color.aqua, text_size = fontSize)
    table.cell(panel, 1, 7, nyReady ? "+" + f_price(estimateUpNY) + " / -" + f_price(estimateDownNY) : lockedWindows ? (selectedLockedReady ? "+" + f_price(selectedLockedUp) + " / -" + f_price(selectedLockedDown) : "--") : estimateValid ? "+" + f_price(estimateUp) + " / -" + f_price(estimateDown) : "--", text_color = fg, text_size = fontSize, tooltip = snapshotTip)
    table.cell(panel, 0, 8, "Forecast / " + forecastState, text_color = color.yellow, text_size = fontSize)
    table.cell(panel, 1, 8, nyReady ? "08:30-" + str.format_time(drawNYEnd, "HH:mm", TZ) + " NY" : lockedWindows ? (selectedSecondWindow ? "05:00-08:30 NY" : "03:00-05:00 NY") : forecastReady ? str.format_time(drawEstimateStart, "MM-dd HH:mm", TZ) + "-" + str.format_time(drawEstimateEnd, "HH:mm", TZ) : "--", text_color = fg, text_size = fontSize, tooltip = snapshotTip)
    table.cell(panel, 0, 9, "Contained / n", text_color = fg, text_size = fontSize)
    table.cell(panel, 1, 9, forecastReady and not followForecast and not lockedWindows ? f_percent(containment) + " / " + str.tostring(estimateN, "#") : "--", text_color = fg, text_size = fontSize, tooltip = followForecast or lockedWindows ? "Hidden in template modes: the source sample and containment do not describe the selected chart candle. Recalculate on the website for a dated estimate." : "Historical fraction whose entire future path stayed inside the sample's mean U/D box. In-sample description, not trade win rate. Upper/lower touch frequencies remain on the website.")

    table.cell(panel, 0, 10, "NY forecast", text_color = color.aqua, text_size = fontSize)
    table.cell(panel, 1, 10, nyStatus, text_color = fg, text_size = fontSize)

f_quarter(float price, float bottom, float top) =>
    float position = top > bottom ? (price - bottom) / (top - bottom) : na
    na(position) ? "--" : position < 0 ? "BELOW" : position < 0.25 ? "Q1" : position < 0.5 ? "Q2" : position < 0.75 ? "Q3" : position <= 1 ? "Q4" : "ABOVE"

f_behaviorName(int code) =>
    code == 1 ? "Higher finish" : code == 2 ? "Lower finish" : code == 3 ? "Trend down then recover" : code == 4 ? "Trend up then fade" : code == 5 ? "Little net change" : "--"

f_inputRow(table t, int row, string name, string value, string font) =>
    table.cell(t, 0, row, name, text_color = color.silver, text_size = font, text_halign = text.align_left)
    table.cell(t, 1, row, value, text_color = color.white, text_size = font, text_halign = text.align_right)

var table inputPanel = table.new(inputCorner == "Top left" ? position.top_left : position.bottom_left, 2, 18, bgcolor = color.new(color.black, 12), border_width = 1)
var string lastLoggedInput = ""
if forecastRenderBar and showInputTable
    string font = panelSize == "Tiny" ? size.tiny : panelSize == "Normal" ? size.normal : size.small
    bool autoNY = not na(array.get(input0830, 0))
    bool auto0500 = not na(array.get(input0500, 0))
    array<float> snap = inputClock == "08:30" or inputClock == "Auto" and autoNY ? input0830 : inputClock == "05:00" or inputClock == "Auto" and auto0500 ? input0500 : input0300
    int stamp = int(array.get(snap, 0))
    float decision = array.get(snap, 1)
    float baseline = array.get(snap, 2)
    float opening = array.get(snap, 3)
    float top = array.get(snap, 4)
    float bottom = array.get(snap, 5)
    float priorTop = array.get(snap, 6)
    float priorBottom = array.get(snap, 7)
    int behavior = int(array.get(snap, 8))
    bool completeInput = array.get(snap, 9) == 1 and baseline > 0 and not na(priorTop) and not na(priorBottom)
    string dateText = na(stamp) ? "Waiting for cutoff" : str.format_time(stamp, "yyyy-MM-dd", TZ)
    string timeText = na(stamp) ? inputClock : str.format_time(stamp, "HH:mm", TZ)
    f_inputRow(inputPanel, 0, "WEBSITE INPUTS", dateText + " / " + timeText, font)
    f_inputRow(inputPanel, 1, "Contract", syminfo.ticker, font)
    f_inputRow(inputPanel, 2, "Decision open", f_price(decision), font)
    f_inputRow(inputPanel, 3, "AVR / source", f_price(baseline) + (manualAvr > 0 ? " / manual" : " / " + str.tostring(array.get(snap, 10), "#") + " NY"), font)
    f_inputRow(inputPanel, 4, "19:30 open", f_price(opening), font)
    f_inputRow(inputPanel, 5, "Overnight H / L", f_price(top) + " / " + f_price(bottom), font)
    f_inputRow(inputPanel, 6, "Prior NY H / L", f_price(priorTop) + " / " + f_price(priorBottom), font)
    f_inputRow(inputPanel, 7, "AVR printed", f_percent(baseline > 0 ? 100 * (top - bottom) / baseline : na), font)
    f_inputRow(inputPanel, 8, "U / D from 19:30", f_price(top - opening) + " / " + f_price(opening - bottom), font)
    f_inputRow(inputPanel, 9, "Price in night range", f_percent(top > bottom ? 100 * (decision - bottom) / (top - bottom) : na), font)
    f_inputRow(inputPanel, 10, "Price vs prior BBOX", f_quarter(decision, priorBottom, priorTop), font)
    f_inputRow(inputPanel, 11, "Last-hour rule", f_behaviorName(behavior), font)
    bool asiaReady = array.get(snap, 14) == 1
    bool londonReady = array.get(snap, 18) == 1
    f_inputRow(inputPanel, 12, "Asia close vs BBOX", asiaReady ? f_quarter(array.get(snap, 11), priorBottom, priorTop) : "Not complete", font)
    f_inputRow(inputPanel, 13, "Asia close / own range", asiaReady ? f_quarter(array.get(snap, 11), array.get(snap, 13), array.get(snap, 12)) : "Not complete", font)
    f_inputRow(inputPanel, 14, "London close vs BBOX", londonReady ? f_quarter(array.get(snap, 15), priorBottom, priorTop) : "Known at 08:30", font)
    f_inputRow(inputPanel, 15, "London close / own range", londonReady ? f_quarter(array.get(snap, 15), array.get(snap, 17), array.get(snap, 16)) : "Known at 08:30", font)
    f_inputRow(inputPanel, 16, "Input status", na(stamp) ? "Waiting for selected bar" : completeInput ? "Frozen at cutoff" : "Incomplete - check bars / AVR", font)
    f_inputRow(inputPanel, 17, "Tags / session shapes", "Review manually", font)
    string packet = "NSPI1|" + dateText + "|" + timeText + "|" + syminfo.tickerid + "|" + f_price(decision) + "|" + str.tostring(baseline, "#.######") + "|" + f_price(opening) + "|" + f_price(top) + "|" + f_price(bottom) + "|" + f_price(priorTop) + "|" + f_price(priorBottom) + "|" + str.tostring(behavior) + "|1|" + (manualAvr > 0 ? "manual" : "10NY")
    if logInput and completeInput and packet != lastLoggedInput
        log.info("{0}", packet)
        lastLoggedInput := packet



// NBPR1 is independent of the SPNQ1 forecast parser and drawing arrays.
// A malformed return code must never disable the forecast boxes.
var array<string> brParts = str.split(str.trim(bboxReturnCode), "|")
bool brHeader = array.size(brParts) == 11 and array.get(brParts, 0) == "NBPR1"
int brStart = brHeader ? int(str.tonumber(array.get(brParts, 1))) : na
int brEnd = brHeader ? int(str.tonumber(array.get(brParts, 2))) : na
float brSide = brHeader ? str.tonumber(array.get(brParts, 3)) : na
float brGroup = brHeader ? str.tonumber(array.get(brParts, 4)) : na
float brHits = brHeader ? str.tonumber(array.get(brParts, 5)) : na
float brCount = brHeader ? str.tonumber(array.get(brParts, 6)) : na
float brLo = brHeader ? str.tonumber(array.get(brParts, 7)) : na
float brHi = brHeader ? str.tonumber(array.get(brParts, 8)) : na
int brAnchor = brHeader ? int(str.tonumber(array.get(brParts, 9))) : na
float brConditional = brHeader ? str.tonumber(array.get(brParts, 10)) : na
float brPercent = brCount > 0 ? 100 * brHits / brCount : na
bool brValid = brHeader and not na(brStart) and not na(brEnd) and not na(brAnchor) and brStart > 0 and brStart >= brAnchor and brEnd > brStart and brEnd - brAnchor <= 21600000 and (brSide == 1 or brSide == -1) and (brGroup == 0 or brGroup == 1) and (brConditional == 0 or brConditional == 1) and brCount >= 1 and brCount == math.floor(brCount) and brHits >= 0 and brHits <= brCount and brHits == math.floor(brHits) and brLo >= 0 and brHi <= 100 and brLo <= brPercent and brHi >= brPercent
var float brEdge = na
// Freeze the prior NY boundary when the encoded observation/update is reached.
// Reading priorNyLow at the final chart candle could accidentally use a newer NY box.
if brValid and inputWithinCursor and time <= brStart and time_close > brStart and priorNyHigh > priorNyLow
    brEdge := brSide == 1 ? priorNyHigh : priorNyLow
var line brLine = na
var label brLabel = na
if forecastRenderBar
    line.delete(brLine)
    label.delete(brLabel)
    brLine := na
    brLabel := na
    if showBBoxReturn and str.length(str.trim(bboxReturnCode)) > 0
        color brPurple = color.rgb(150, 55, 220)
        if brValid and not na(brEdge)
            string brWindow = str.format_time(brStart, "yyyy-MM-dd HH:mm", TZ) + " to " + str.format_time(brEnd, "HH:mm", TZ) + " NY"
            string brState = brGroup == 1 ? "Outside BBOX + Mean SessionPath" : "Outside BBOX only"
            string brNote = "Q6 historical close-return frequency; " + str.tostring(brHits, "#") + "/" + str.tostring(brCount, "#") + " dates. 95% interval " + str.tostring(brLo, "#.0") + "% to " + str.tostring(brHi, "#.0") + "%.\n" + brWindow + ". " + brState + ".\nObservation block " + str.format_time(brAnchor, "HH:mm", TZ) + " to " + str.format_time(brAnchor + 1740000, "HH:mm", TZ) + ". " + (brConditional == 1 ? "Conditional on no earlier close back inside by the line start." : "Original block reference; not an exact-minute model.") + "\nA later completed 5m close must be inside the whole BBOX. A wick touch is not a return. Prior complete NY 09:30-16:00 range on this contract. NQ Mean reference imported from the website; check the source model and historical cutoff there. Not a trade win rate or automatic live update."
            brLine := line.new(brStart, brEdge, brEnd, brEdge, xloc = xloc.bar_time, color = brPurple, style = line.style_solid, width = 3)
            brLabel := label.new(int((brStart + brEnd) / 2), brEdge, "Hist " + str.tostring(brPercent, "#.0") + "% close back inside", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(brPurple, 100), textcolor = brPurple, size = size.tiny, tooltip = brNote)
        else
            string brProblem = not brValid ? "BBOX return: invalid NBPR1 code" : time < brStart ? "BBOX return: waiting for coded date/time" : "BBOX return: load the coded date and a complete prior NY session"
            brLabel := label.new(time, close, brProblem, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(brPurple, 15), textcolor = color.white, size = size.tiny)
