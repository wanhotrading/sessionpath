//@version=6
// Session Path NQ v1.2. Standard 5-minute NQ/MNQ chart; all clocks America/New_York.
// Range and quartiles freeze at 04:30. U/D and running extremes continue through 08:30.
// AVR = mean last 10 COMPLETE NY 09:30-16:00 high-low ranges, frozen at 19:30.
// Forecast code comes from the local research website. No automatic website connection.
// Quarter location selects a scenario, not an estimated success probability.
indicator("SessionPath.By LUI NQ v1.2 - overnight + NY + input table", overlay = true, max_boxes_count = 24, max_lines_count = 100, max_labels_count = 70, max_bars_back = 20)

string TZ = "America/New_York"
float manualAvr = input.float(0.0, "AVR override in points (0 = automatic)", minval = 0, step = 0.25, group = "Range and AVR", tooltip = "Automatic uses the last ten complete NY sessions on this chart's symbol. Prefer an explicit delivery contract. A manual override is frozen for the night; change it when your baseline changes.")
string anchorMode = input.string("Frozen 04:30", "AVR anchor", options = ["Frozen 04:30", "Latest overnight extreme"], group = "Range and AVR")
bool showAvr = input.bool(true, "Show conditional 1x AVR projection", group = "Range and AVR")
string forecastCode = input.string("", "Forecast code from website", group = "Historical estimate", tooltip = "Box edges use mean U/D. White dotted lines show medians; orange dotted lines show means. SPNQ1/SPNQ2 maxima are retained for compatibility only. Main code: use a 03:00 estimate with a 05:00 endpoint for the first locked window. The optional 05:00 code supplies updated distances for the second window. Imported widths are fixed templates, not automatic historical recalculations.")
string forecastCode0500 = input.string("", "05:00 forecast code (optional)", group = "Historical estimate", tooltip = "For new 05:00 U/D distances, paste a separate website code calculated at 05:00 with the 08:30 endpoint. Blank leaves the second box empty until a new 05:00 code is supplied. An invalid nonblank code disables the second box instead of silently falling back.")
string forecastCodeNY = input.string("", "NY forecast code (08:30)", group = "Historical estimate", tooltip = "Paste the NY code here. The box locks to the chart's 08:30 open and ends at 10:30 or 16:00, as encoded. A NY code in the main field is also recognised. Widths come from the website; refresh them for every dated test.")
bool showInputTable = input.bool(true, "Show website input table", group = "Input helper")
string inputClock = input.string("Auto", "Input snapshot", options = ["Auto", "03:00", "05:00", "08:30"], group = "Input helper", tooltip = "Freeze the selected cutoff using only earlier completed candles plus its opening price. Auto selects the latest available cutoff on the selected chart date.")
string inputCorner = input.string("Top left", "Input table position", options = ["Top left", "Bottom left"], group = "Input helper")
bool logInput = input.bool(false, "Write snapshot to Pine Logs", group = "Input helper", tooltip = "Open Pine Logs and copy the NSPI1 line. Paste it into the website's Replay tools. No alert or API connection is needed. Logs are emitted only for complete snapshots.")
string forecastPlacement = input.string("03:00 / 05:00 locked windows", "Forecast placement", options = ["03:00 / 05:00 locked windows", "Follow chart candle", "Original dated snapshot"], group = "Historical estimate")
string forecastCursor = input.string("Last visible candle", "Candle to follow", options = ["Last visible candle", "Latest chart / replay candle"], group = "Historical estimate", tooltip = "Last visible candle follows the rightmost visible bar, including when you scroll back. Latest chart / replay candle follows the last available bar regardless of scrolling. Follow chart candle mode uses the previous completed close while a candle is unfinished. Locked windows instead use the exact 03:00 and 05:00 opening prices, available as soon as those bars open.")
string panelSize = input.string("Small", "Table text size", options = ["Tiny", "Small", "Normal"], group = "Display")
string meanOuterBands = input.string("Both", "Mean-box outer lines", options = ["Off", "10%", "15%", "Both"], group = "Mean box extensions", tooltip = "Purple dotted Fibonacci-style levels measured using the FULL Mean box width W = Mean U + Mean D. Upper + 0.10W / 0.15W and lower - 0.10W / 0.15W. Equivalent levels 1.10 / 1.15 and -0.10 / -0.15 with lower=0, upper=1. These are final-close tolerance thresholds, not guaranteed reversal levels. Median distances are never used.")
bool showMeanUpper = input.bool(true, "Upper extension lines", group = "Mean box extensions")
bool showMeanLower = input.bool(true, "Lower extension lines", group = "Mean box extensions")
// Q7 uses the full imported Mean box. These are range multiples, not standard deviations.
string rangeExtensionMode = input.string("First breached side", "Orange extensions", options = ["Off", "First breached side", "Both sides"], group = "SessionPath range multiples", tooltip = "Uses the imported Mean box only. W = U extreme - D extreme. Upward 1.2 = D + 1.2W; downward 1.2 = U - 1.2W. First breached side follows the first strict high/low breach within this window, including wicks. Both sides prepares both directions before a breach. Same-bar first breaches of both sides show both with a ? label because order is unknown. Follow chart candle mode supports Both sides only.")
bool range105 = input.bool(false, "1.05 (105%)", inline = "r1", group = "SessionPath range multiples")
bool range110 = input.bool(false, "1.10 (110%)", inline = "r1", group = "SessionPath range multiples")
bool range115 = input.bool(false, "1.15 (115%)", inline = "r2", group = "SessionPath range multiples")
bool range120 = input.bool(true, "1.20 (120%)", inline = "r2", group = "SessionPath range multiples")
bool range130 = input.bool(true, "1.30 (130%)", inline = "r3", group = "SessionPath range multiples")
bool range140 = input.bool(false, "1.40 (140%)", inline = "r3b", group = "SessionPath range multiples")
bool range150 = input.bool(false, "1.50 (150%)", inline = "r3", group = "SessionPath range multiples")
bool range175 = input.bool(false, "1.75 (175%)", inline = "r4", group = "SessionPath range multiples")
bool range200 = input.bool(false, "2.00 (200%)", inline = "r4", group = "SessionPath range multiples")
bool showRangeHitRates = input.bool(true, "Historical hit rates on orange labels", group = "SessionPath range multiples", tooltip = "03:00/05:00 keep their existing first-side historical references. NY uses the new direction-specific earlier-only research; choose its method, cohort, fit minimum and probability basis below. Upper and lower are measured separately. Counts and intervals appear on hover. These are historical frequencies, not live fitted probabilities or trade win rates.")
string q7History = input.string("Earlier-date boxes", "NQ 03:00/05:00 probability reference", options = ["Earlier-date boxes", "All-history reconstruction"], group = "SessionPath range multiples", tooltip = "Only the two early windows use this selector; new NY rates always use earlier-only forecasts. Earlier-date boxes exclude the observation date and all later dates from each historical forecast. Retrospective reconstruction includes them, matching the original capture protocol. Both are descriptive reference frequencies and may include low-count forecast fits; neither is a trade win rate.")
string nyQ7Reference = input.string("Not specified", "NY research method", options = ["Not specified", "Own Exact", "Own Wide", "Prior Exact", "Prior Wide"], group = "NY extension probabilities", tooltip = "Match the website NY forecast method exactly. Own uses each completed session's own range; Prior uses the previous NY BBOX. Exact/Wide keep their original classification rules. Codes do not encode this method. New rates use strictly earlier matched days, only NY 08:30-16:00, and only 1.20/1.30/1.40/1.50 levels. No NY probability is shown until selected.")
string nyProbabilityBasis = input.string("Pending after confirmation", "NY probability basis", options = ["Whole-window directional", "First breakout side", "Pending after confirmation"], group = "NY extension probabilities", tooltip = "Whole-window: independent upper/lower target touch frequencies across all eligible NY forecasts, including no-break days. First breakout side: conditional on that side breaking first; includes trigger-candle target hits. Pending: target still untouched at the first breakout candle's close and next opening price, with candles remaining; only later target hits count. Pending is a historical reference at first confirmation, NOT a probability updated for every later minute. All three bases keep UP and DOWN separate.")
string nyProbabilityFit = input.string("50+ earlier matches", "NY historical fit minimum", options = ["50+ earlier matches", "1+ earlier match (sensitivity)"], group = "NY extension probabilities", tooltip = "50+ is the primary sample. Sensitivity includes sparse historical fits. Your imported NY forecast must also meet the chosen minimum. An orange-tail reference additionally requires its earlier orange forecast to meet that minimum. Counts and 95% Wilson intervals appear on hover; small tail groups are exploratory.")
string nyProbabilityCohort = input.string("All eligible NY forecasts", "NY preceding tail event", options = ["All eligible NY forecasts", "04:30 double break - second U", "04:30 double break - second D", "03:00-05:00 both orange boxes - second U", "03:00-05:00 both orange boxes - second D", "05:00-08:30 both orange boxes - second U", "05:00-08:30 both orange boxes - second D"], group = "NY extension probabilities", tooltip = "Manually select a pre-08:30 event that actually completed. U/D here is the SECOND side of the earlier tail event, not the later NY breakout direction. The orange event means both outer AVR-expansion targets touched; a new high and new low alone is insufficient. Unknown same-candle second-side order does not qualify. These historical slices do not automatically detect or refit today's event.")
bool rangeLevelLabels = input.bool(true, "Label orange multiples", group = "SessionPath range multiples", tooltip = "1.10 and 1.15 share prices with the purple 10% and 15% tolerance lines. Turn those orange levels off to keep purple visible.")

bool showForecast = input.bool(true, "Show imported mean U/D box", group = "Historical estimate")
bool showMatchedExpansion = input.bool(true, "Show dated AVR expansion boxes", group = "Matched AVR expansion", tooltip = "New website codes include two orange boxes: cutoff cumulative high to high + mean additional expansion, and low - mean additional expansion to cutoff cumulative low. Each historical extra move is divided by that day's AVR, averaged across the SAME forecast matches including zero moves, then multiplied by your entered AVR. Anchors, code date and deadline stay fixed even when scrolling or following a candle. Zero expansion has no rectangle. Older codes keep their mean boxes but do not contain this layer.")
string bboxReturnCode = input.string("", "BBOX return code", group = "BBOX return probability", tooltip = "Paste the separate NBPR1 code from the site's BBOX return panel. Uses its exact trading date, direction, observation block and deadline. U targets the prior complete NY BBOX high; D targets its low. This imports a historical CLOSE-back-inside frequency, not a wick-touch probability. Recalculate and paste again when your scenario changes; old codes do not update automatically.")
bool showBBoxReturn = input.bool(true, "Show BBOX return line", group = "BBOX return probability")


if not timeframe.isminutes or timeframe.multiplier != 5
    runtime.error("Use a standard 5-minute chart with overnight bars enabled.")
if not chart.is_standard
    runtime.error("Use standard candles, not Heikin Ashi, Renko or another synthetic chart.")
if syminfo.root != "NQ" and syminfo.root != "MNQ"
    runtime.error("This research is for NQ/MNQ futures. Use an explicit NQ contract for database comparisons.")

f_price(float value) =>
    na(value) ? "--" : str.tostring(value, "#.00")
f_percent(float value) =>
    na(value) ? "--" : str.tostring(value, "#.0") + "%"

int clockMinute = hour(time, TZ) * 60 + minute(time, TZ)
bool inNy = clockMinute >= 570 and clockMinute < 960
var array<float> nyRanges = array.new<float>()
var float nyHigh = na
var float nyLow = na
var int nyCount = 0
var int nyPreviousClose = na
var bool nyComplete = false
var float priorNyHigh = na
var float priorNyLow = na
if barstate.isconfirmed and inNy
    if clockMinute == 570
        nyHigh := high
        nyLow := low
        nyCount := 0
        nyPreviousClose := time
        nyComplete := true
    if nyCount == 0 and clockMinute != 570
        nyComplete := false
    if time != nyPreviousClose
        nyComplete := false
    nyHigh := na(nyHigh) ? high : math.max(nyHigh, high)
    nyLow := na(nyLow) ? low : math.min(nyLow, low)
    nyCount += 1
    nyPreviousClose := time_close
    if clockMinute == 955
        if nyComplete and nyCount == 78
            priorNyHigh := nyHigh
            priorNyLow := nyLow
            array.push(nyRanges, nyHigh - nyLow)
            if array.size(nyRanges) > 10
                array.shift(nyRanges)
        nyCount := 0
        nyComplete := false

int localYear = year(time, TZ)
int localMonth = month(time, TZ)
int localDay = dayofmonth(time, TZ)
int anchorDay = clockMinute >= 1170 ? localDay : localDay - 1
int startForBar = timestamp(TZ, localYear, localMonth, anchorDay, 19, 30)
int lockForBar = timestamp(TZ, localYear, localMonth, anchorDay + 1, 4, 30)
int endForBar = timestamp(TZ, localYear, localMonth, anchorDay + 1, 8, 30)
bool inOvernight = time >= startForBar and time < endForBar

var int sessionStart = na
var int sessionLock = na
var int sessionEnd = na
var int asof = na
var int barCount = 0
var bool complete = false
var bool frozen = false
var float open1930 = na
var float runningHigh = na
var float runningLow = na
var float fixedHigh = na
var float fixedLow = na
var float lastPrice = na
var float nightAvr = na
var int avrSessions = 0
var bool highBroken = false
var bool lowBroken = false

bool inputWithinCursor = forecastCursor != "Last visible candle" or time <= chart.right_visible_bar_time
int inputDayForBar = timestamp(TZ, localYear, localMonth, localDay, 0, 0)
var int inputDay = na
var array<float> input0300 = array.new<float>(19, na)
var array<float> input0500 = array.new<float>(19, na)
var array<float> input0830 = array.new<float>(19, na)
var float asiaHighInput = na
var float asiaLowInput = na
var float asiaCloseInput = na
var int asiaCountInput = 0
var float londonHighInput = na
var float londonLowInput = na
var float londonCloseInput = na
var int londonCountInput = 0

f_behavior(float baseline) =>
    int code = 0
    if baseline > 0 and not na(close[13])
        float base = close[13]
        float bottom = 0.0
        float top = 0.0
        int bottomAt = 0
        int topAt = 0
        bool contiguous = true
        for i = 12 to 1
            contiguous := contiguous and time[i] == time - i * 300000
            float value = (close[i] - base) / baseline
            if value < bottom
                bottom := value
                bottomAt := 13 - i
            if value > top
                top := value
                topAt := 13 - i
        float finish = (close[1] - base) / baseline
        bool recovery = bottom <= -0.08 and finish - bottom >= 0.08 and bottomAt < 12
        bool fade = top >= 0.08 and top - finish >= 0.08 and topAt < 12
        code := not contiguous ? 0 : recovery and fade ? (bottomAt < topAt ? 4 : 3) : recovery ? 3 : fade ? 4 : finish >= 0.05 ? 1 : finish <= -0.05 ? 2 : 5
    code

if inputWithinCursor
    if na(inputDay) or inputDay != inputDayForBar
        inputDay := inputDayForBar
        array.fill(input0300, na)
        array.fill(input0500, na)
        array.fill(input0830, na)
    if clockMinute == 180 or clockMinute == 300 or clockMinute == 510
        array<float> target = clockMinute == 180 ? input0300 : clockMinute == 300 ? input0500 : input0830
        bool inputComplete = complete and asof == time and sessionStart == startForBar and not na(open1930)
        array.set(target, 0, time)
        array.set(target, 1, open)
        array.set(target, 2, nightAvr)
        array.set(target, 3, open1930)
        array.set(target, 4, math.max(runningHigh, open))
        array.set(target, 5, math.min(runningLow, open))
        array.set(target, 6, priorNyHigh)
        array.set(target, 7, priorNyLow)
        array.set(target, 8, f_behavior(nightAvr))
        array.set(target, 9, inputComplete ? 1 : 0)
        array.set(target, 10, avrSessions)
        array.set(target, 11, asiaCloseInput)
        array.set(target, 12, asiaHighInput)
        array.set(target, 13, asiaLowInput)
        array.set(target, 14, asiaCountInput == 78 ? 1 : 0)
        array.set(target, 15, londonCloseInput)
        array.set(target, 16, londonHighInput)
        array.set(target, 17, londonLowInput)
        array.set(target, 18, londonCountInput == 66 and clockMinute == 510 ? 1 : 0)
    if barstate.isconfirmed
        if clockMinute == 1170
            asiaHighInput := na
            asiaLowInput := na
            asiaCloseInput := na
            asiaCountInput := 0
            londonHighInput := na
            londonLowInput := na
            londonCloseInput := na
            londonCountInput := 0
        if clockMinute >= 1170 or clockMinute < 120
            asiaHighInput := na(asiaHighInput) ? high : math.max(asiaHighInput, high)
            asiaLowInput := na(asiaLowInput) ? low : math.min(asiaLowInput, low)
            asiaCloseInput := close
            asiaCountInput += 1
        if clockMinute >= 180 and clockMinute < 510
            londonHighInput := na(londonHighInput) ? high : math.max(londonHighInput, high)
            londonLowInput := na(londonLowInput) ? low : math.min(londonLowInput, low)
            londonCloseInput := close
            londonCountInput += 1

if barstate.isconfirmed and inOvernight
    if na(sessionStart) or sessionStart != startForBar
        sessionStart := startForBar
        sessionLock := lockForBar
        sessionEnd := endForBar
        asof := startForBar
        barCount := 0
        complete := time == startForBar
        frozen := false
        open1930 := time == startForBar ? open : na
        runningHigh := high
        runningLow := low
        fixedHigh := na
        fixedLow := na
        highBroken := false
        lowBroken := false
        avrSessions := array.size(nyRanges)
        nightAvr := manualAvr > 0 ? manualAvr : avrSessions == 10 ? array.avg(nyRanges) : na
    if time != asof
        complete := false
    runningHigh := math.max(runningHigh, high)
    runningLow := math.min(runningLow, low)
    lastPrice := close
    asof := time_close
    barCount += 1
    if time < sessionLock and time_close == sessionLock and complete and barCount == 108
        fixedHigh := runningHigh
        fixedLow := runningLow
        frozen := true
    if time >= sessionLock and frozen
        bool upBreak = high > fixedHigh
        bool downBreak = low < fixedLow
        highBroken := highBroken or upBreak
        lowBroken := lowBroken or downBreak

float printed = runningHigh - runningLow
float observedUp = runningHigh - open1930
float observedDown = open1930 - runningLow
float q = frozen and fixedHigh > fixedLow ? (lastPrice - fixedLow) / (fixedHigh - fixedLow) : na
bool active = complete and frozen and asof >= sessionLock and asof < sessionEnd and time < sessionEnd
int side = not na(q) ? q >= 0.75 ? 1 : q <= 0.25 ? -1 : 0 : 0
bool anchorFailed = anchorMode == "Frozen 04:30" and (side == 1 ? lowBroken : side == -1 ? highBroken : false)
float avrAnchor = side == 1 ? (anchorMode == "Frozen 04:30" ? fixedLow : runningLow) : side == -1 ? (anchorMode == "Frozen 04:30" ? fixedHigh : runningHigh) : na
float avrTarget = side == 1 ? avrAnchor + nightAvr : side == -1 ? avrAnchor - nightAvr : na
bool targetReached = not na(avrTarget) and (side == 1 ? runningHigh >= avrTarget : runningLow <= avrTarget)
string avrState = not complete ? "Incomplete overnight data" : not frozen ? "Waiting for complete 04:30 range" : not active ? "Window ended at 08:30" : side == 0 ? "Middle 50%: no AVR projection" : anchorFailed ? "Original opposite boundary broke: projection invalid" : na(nightAvr) ? "Load 10 full NY sessions or enter AVR" : targetReached ? "1x AVR level already reached" : side == 1 ? "Upper quarter: low + AVR" : "Lower quarter: high - AVR"

var box rangeBox = na
var line rangeHighLine = na
var line rangeLowLine = na
var line q1Line = na
var line midLine = na
var line q3Line = na
var box avrBox = na
var label rangeLabel = na
var label avrLabel = na
if barstate.islast
    box.delete(rangeBox)
    line.delete(rangeHighLine)
    line.delete(rangeLowLine)
    line.delete(q1Line)
    line.delete(midLine)
    line.delete(q3Line)
    box.delete(avrBox)
    label.delete(rangeLabel)
    label.delete(avrLabel)
    if complete and not na(sessionStart)
        float boxHigh = frozen ? fixedHigh : runningHigh
        float boxLow = frozen ? fixedLow : runningLow
        int boxRight = frozen ? sessionLock : asof
        rangeBox := box.new(left = sessionStart, top = boxHigh, right = boxRight, bottom = boxLow, xloc = xloc.bar_time, border_color = color.silver, bgcolor = color.new(color.blue, 92))
        rangeLabel := label.new(x = boxRight, y = boxHigh, text = frozen ? "19:30-04:30 FROZEN range" : "19:30 range forming", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.gray, 35), textcolor = color.white, size = size.small)
        if frozen
            float w = fixedHigh - fixedLow
            rangeHighLine := line.new(x1 = sessionLock, y1 = fixedHigh, x2 = sessionEnd, y2 = fixedHigh, xloc = xloc.bar_time, color = color.silver)
            rangeLowLine := line.new(x1 = sessionLock, y1 = fixedLow, x2 = sessionEnd, y2 = fixedLow, xloc = xloc.bar_time, color = color.silver)
            q1Line := line.new(x1 = sessionStart, y1 = fixedLow + 0.25 * w, x2 = sessionEnd, y2 = fixedLow + 0.25 * w, xloc = xloc.bar_time, color = color.new(color.silver, 40), style = line.style_dotted)
            midLine := line.new(x1 = sessionStart, y1 = fixedLow + 0.5 * w, x2 = sessionEnd, y2 = fixedLow + 0.5 * w, xloc = xloc.bar_time, color = color.new(color.silver, 60), style = line.style_dotted)
            q3Line := line.new(x1 = sessionStart, y1 = fixedLow + 0.75 * w, x2 = sessionEnd, y2 = fixedLow + 0.75 * w, xloc = xloc.bar_time, color = color.new(color.silver, 40), style = line.style_dotted)
        if showAvr and active and side != 0 and not anchorFailed and nightAvr > 0
            color scenarioColor = color.orange
            avrBox := box.new(left = asof, top = math.max(avrAnchor, avrTarget), right = sessionEnd, bottom = math.min(avrAnchor, avrTarget), xloc = xloc.bar_time, border_color = color.rgb(139, 0, 0), border_width = 4, border_style = line.style_dashed, bgcolor = color.new(color.orange, 85))
            avrLabel := label.new(x = sessionEnd, y = avrTarget, text = "1x AVR scenario " + f_price(avrTarget) + "\n" + anchorMode + " anchor " + f_price(avrAnchor) + (targetReached ? "\nALREADY REACHED" : "\nNot a historical mean target"), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(scenarioColor, 20), textcolor = color.white, size = size.small)

// One small website export, not the historical dataset. Keep source values intact.
var array<string> payload = str.split(str.trim(forecastCode), "|")
var int estimateStart = na
var int estimateEnd = na
var float estimatePrice = na
var float estimateUp = na
var float estimateDown = na
var float estimateN = na
var float containment = na
var float touchUp = na
var float touchDown = na
var float estimateAvr = na
var float estimateMaxUp = na
var float estimateMaxDown = na
var float estimateMedianUp = na
var float estimateMedianDown = na
var float estimateRangeHigh = na
var float estimateRangeLow = na
var float estimateExtensionUp = na
var float estimateExtensionDown = na
var bool estimateExpansionValid = false
var bool estimateValid = false
if barstate.isfirst and str.length(forecastCode) > 0
    if array.size(payload) == 15 or array.size(payload) == 19
        if (array.size(payload) == 15 and array.get(payload, 0) == "SPNQ1") or (array.size(payload) == 19 and array.get(payload, 0) == "SPNQ2")
            estimateStart := int(str.tonumber(array.get(payload, 1)))
            estimateEnd := int(str.tonumber(array.get(payload, 2)))
            estimatePrice := str.tonumber(array.get(payload, 3))
            estimateUp := str.tonumber(array.get(payload, 4))
            estimateDown := str.tonumber(array.get(payload, 5))
            estimateN := str.tonumber(array.get(payload, 6))
            containment := str.tonumber(array.get(payload, 7))
            touchUp := str.tonumber(array.get(payload, 8))
            touchDown := str.tonumber(array.get(payload, 9))
            estimateAvr := str.tonumber(array.get(payload, 10))
            estimateMaxUp := estimateUp
            estimateMaxDown := estimateDown
            if array.size(payload) >= 15
                estimateMaxUp := str.tonumber(array.get(payload, 11))
                estimateMaxDown := str.tonumber(array.get(payload, 12))
                estimateMedianUp := str.tonumber(array.get(payload, 13))
                estimateMedianDown := str.tonumber(array.get(payload, 14))
            estimateValid := not na(estimateStart) and not na(estimateEnd) and not na(estimatePrice) and not na(estimateUp) and not na(estimateDown) and not na(estimateN) and not na(containment) and not na(touchUp) and not na(touchDown) and not na(estimateAvr)
            estimateValid := estimateValid and estimateStart > 0 and estimateEnd > estimateStart and estimateEnd - estimateStart <= 46800000 and estimateUp >= 0 and estimateDown >= 0 and estimateN >= 1 and estimateN == math.floor(estimateN) and estimateAvr > 0 and containment >= 0 and containment <= 100 and touchUp >= 0 and touchUp <= 100 and touchDown >= 0 and touchDown <= 100
            if array.size(payload) >= 15
                estimateValid := estimateValid and not na(estimateMaxUp) and not na(estimateMaxDown) and not na(estimateMedianUp) and not na(estimateMedianDown) and estimateMaxUp >= estimateUp and estimateMaxDown >= estimateDown and estimateMedianUp >= 0 and estimateMedianDown >= 0 and estimateMedianUp <= estimateMaxUp and estimateMedianDown <= estimateMaxDown
            if array.size(payload) == 19
                estimateRangeHigh := str.tonumber(array.get(payload, 15))
                estimateRangeLow := str.tonumber(array.get(payload, 16))
                estimateExtensionUp := str.tonumber(array.get(payload, 17))
                estimateExtensionDown := str.tonumber(array.get(payload, 18))
                estimateExpansionValid := not na(estimateRangeHigh) and not na(estimateRangeLow) and not na(estimateExtensionUp) and not na(estimateExtensionDown) and estimateRangeHigh >= estimateRangeLow and estimatePrice >= estimateRangeLow - 0.00000001 and estimatePrice <= estimateRangeHigh + 0.00000001 and estimateExtensionUp >= 0 and estimateExtensionDown >= 0
                estimateValid := estimateValid and estimateExpansionValid

// Optional second snapshot is independent; a malformed supplied code never falls back.
var array<string> payload0500 = str.split(str.trim(forecastCode0500), "|")
var int estimateStart0500 = na
var int estimateEnd0500 = na
var float estimatePrice0500 = na
var float estimateUp0500 = na
var float estimateDown0500 = na
var float estimateN0500 = na
var float containment0500 = na
var float touchUp0500 = na
var float touchDown0500 = na
var float estimateAvr0500 = na
var float estimateMaxUp0500 = na
var float estimateMaxDown0500 = na
var float estimateMedianUp0500 = na
var float estimateMedianDown0500 = na
var float estimateRangeHigh0500 = na
var float estimateRangeLow0500 = na
var float estimateExtensionUp0500 = na
var float estimateExtensionDown0500 = na
