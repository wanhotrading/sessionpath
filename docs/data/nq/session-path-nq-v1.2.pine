// Pine drawing objects reproduce Fibonacci extension levels; native mouse-drawn Fib objects are separate.
f_meanOuterLines(int start, int finish, float price, float meanUp, float meanDown) =>
    float fullWidth = meanUp + meanDown
    if fullWidth > 0 and meanOuterBands != "Off"
        for levelIndex = 0 to 1
            float fraction = levelIndex == 0 ? 0.10 : 0.15
            bool enabled = meanOuterBands == "Both" or (levelIndex == 0 and meanOuterBands == "10%") or (levelIndex == 1 and meanOuterBands == "15%")
            if enabled
                if showMeanUpper
                    float upperLevel = price + meanUp + fraction * fullWidth
                    array.push(forecastStatLines, line.new(start, upperLevel, finish, upperLevel, xloc = xloc.bar_time, color = color.rgb(173, 95, 230), style = line.style_dotted, width = 1))
                if showMeanLower
                    float lowerLevel = price - meanDown - fraction * fullWidth
                    array.push(forecastStatLines, line.new(start, lowerLevel, finish, lowerLevel, xloc = xloc.bar_time, color = color.rgb(173, 95, 230), style = line.style_dotted, width = 1))

