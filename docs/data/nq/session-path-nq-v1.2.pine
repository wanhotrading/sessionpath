// NY state uses only chart candles at/before the selected visible/replay cursor.
// The opening timestamp identifies a candle; its breach confirms at time_close.
f_nyProbabilityState(int start, int finish, float upper, float lower) =>
    var int activeStart = na
    var int firstSide = 0
    var int breachTime = na
    var int previousEnd = na
    var bool hasStart = false
    var bool contiguous = true
    var bool breachConfirmed = false
    var float seenHigh = na
    var float seenLow = na
    if not na(start) and (na(activeStart) or start != activeStart)
        activeStart := start
        firstSide := 0
        breachTime := na
        previousEnd := na
        hasStart := false
        contiguous := true
        breachConfirmed := false
        seenHigh := na
        seenLow := na
    if withinForecastCursor and not na(upper) and not na(lower) and time >= start and time < finish
        if na(previousEnd)
            hasStart := time == start
        else if time != previousEnd
            contiguous := false
        seenHigh := na(seenHigh) ? high : math.max(seenHigh, high)
        seenLow := na(seenLow) ? low : math.min(seenLow, low)
        if firstSide == 0
            bool upBreach = high > upper + 0.000000001
            bool downBreach = low < lower - 0.000000001
            if upBreach or downBreach
                firstSide := upBreach and downBreach ? 2 : upBreach ? 1 : -1
                breachTime := time
        if firstSide != 0 and (time > breachTime or barstate.isconfirmed)
            breachConfirmed := true
        previousEnd := time_close
    [firstSide, breachTime, breachConfirmed, seenHigh, seenLow, hasStart and contiguous]

